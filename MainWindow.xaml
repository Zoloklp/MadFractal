<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MadFractal.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MadFractal"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="MadFractal">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid"
          Background="Black"
          KeyboardAcceleratorPlacementMode="Hidden"
          PointerPressed="RootGrid_PointerPressed"
          PointerMoved="RootGrid_PointerMoved"
          PointerReleased="RootGrid_PointerReleased"
          PointerCanceled="RootGrid_PointerCanceled"
          PointerCaptureLost="RootGrid_PointerCaptureLost">
        <Grid.Resources>
            <Style TargetType="TextBox">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Width" Value="60" />
                <Setter Property="Padding" Value="4,0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="8" />
                <Setter Property="Padding" Value="1" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="PanelBorderStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="12" />
            </Style>
            <Style x:Key="PadBorderStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="10" />
            </Style>
            <Style x:Key="SelectorBorderStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="CircleBorderStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="110" />
            </Style>
            <Style x:Key="PreviewBorderStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style TargetType="ScrollViewer">
                <Setter Property="Margin" Value="1,1,1,1" />
            </Style>
            <Style TargetType="Slider">
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            
        </Grid.Resources>

        <Grid.KeyboardAccelerators >
            <KeyboardAccelerator Key="F11" Invoked="FullScreenKeyboardAccelerator_Invoked" />
            <KeyboardAccelerator Key="E" Invoked="OpenParametersKeyboardAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <SwapChainPanel x:Name="FractalPanel"
                        PointerPressed="FractalPanel_PointerPressed"
                        PointerMoved="FractalPanel_PointerMoved"
                        PointerReleased="FractalPanel_PointerReleased"
                        PointerCanceled="FractalPanel_PointerCanceled"
                        PointerCaptureLost="FractalPanel_PointerCaptureLost"
                        PointerWheelChanged="FractalPanel_PointerWheelChanged" />

        <Grid x:Name="ControlPanel"
              Visibility="Visible"
              Margin="16"
              Padding="0"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Top">
                    <Button x:Name="SettingsButton"
                            Content="⚙"
                            Click="SettingsButton_Click"
                            Padding="8"
                            MinWidth="44"
                            ToolTipService.ToolTip="Настройки"
                            AutomationProperties.Name="Открыть настройки" />
                    <Border x:Name="SettingsStrip"
                            Visibility="Collapsed"
                            Padding="10"
                            Background="#E51F1F1F"
                            Style="{StaticResource PanelBorderStyle}">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Text="Настройки"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="×"
                                        Click="SettingsPanelCloseButton_Click"
                                        Padding="6,0"
                                        MinWidth="28"
                                        Height="28"
                                        AutomationProperties.Name="Закрыть панель настроек" />
                            </Grid>
                            <StackPanel Grid.Row="1" Spacing="8">
                                <TextBlock Text="Прозрачность" />
                                <Grid ColumnDefinitions="*,64">
                                    <Slider x:Name="PanelOpacitySlider"
                                            Minimum="0.45"
                                            Maximum="1"
                                            StepFrequency="0.01"
                                            Value="0.9"
                                            ValueChanged="ParameterSlider_ValueChanged"
                                            Tag="PanelOpacity" />
                                    <TextBox Grid.Column="1"
                                             Text="0.90"
                                             Tag="PanelOpacity"
                                             KeyDown="ParameterTextBox_KeyDown"
                                             LostFocus="ParameterTextBox_LostFocus" />
                                </Grid>
                                <Button x:Name="PresetsButton"
                                        Content="Пресеты Julia"
                                        Click="PresetsButton_Click"
                                        Padding="8,6"
                                        ToolTipService.ToolTip="Готовые позиции Julia и палитры"
                                        AutomationProperties.Name="Открыть пресеты Julia" />
                                <Border x:Name="PresetsPanel"
                                        Visibility="Collapsed"
                                        Background="#202020"
                                        BorderBrush="#505050"
                                        BorderThickness="1"
                                        Padding="1"
                                        Style="{StaticResource SelectorBorderStyle}">
                                    <ListBox x:Name="PresetSelector"
                                             Height="280"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             SelectionChanged="PresetSelector_SelectionChanged">
                                         <ListBoxItem Content="Аметист — Julia, cosine" />
                                         <ListBoxItem Content="Океан — Julia, orbit line" />
                                         <ListBoxItem Content="Огонь — Julia, metallic" />
                                         <ListBoxItem Content="Мята — sin Julia, orbit line" />
                                         <ListBoxItem Content="Закат — cos Julia, metallic" />
                                         <ListBoxItem Content="Неон — Mandelbrot, orbit square" />
                                         <ListBoxItem Content="Медный вихрь — sin Mandelbrot" />
                                         <ListBoxItem Content="Лёд — cos Mandelbrot" />
                                         <ListBoxItem Content="Розовый ромб — sin Julia" />
                                         <ListBoxItem Content="Хром — cos Julia, metallic" />
                                    </ListBox>
                                </Border>
                        <Button x:Name="InfoButton"
                                Content="Сводка"
                                Click="InfoButton_Click"
                                Padding="8,6"
                                ToolTipService.ToolTip="Сводка о фрактале"
                                AutomationProperties.Name="Показать или скрыть сводку о фрактале" />
                        <Button x:Name="ColorButton"
                                Content="Цвет"
                                Click="ColorButton_Click"
                                Padding="8,6"
                                ToolTipService.ToolTip="Панель цвета"
                                AutomationProperties.Name="Открыть панель цвета" />
                        <Button x:Name="ParametersButton"
                                Content="Параметры"
                                Click="ParametersButton_Click"
                                Padding="8,6"
                                ToolTipService.ToolTip="Параметры фрактала"
                                AutomationProperties.Name="Открыть параметры фрактала" />
                        <Button x:Name="SavePngButton"
                                Content="Save"
                                Click="SavePngButton_Click"
                                Padding="8,6"
                                MinWidth="44"
                                ToolTipService.ToolTip="Сохранить фрактал в PNG"
                                AutomationProperties.Name="Сохранить фрактал в PNG" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="12">
                <Border x:Name="FractalInfoPanel"
                        Grid.Row="0"
                        Visibility="Collapsed"
                        HorizontalAlignment="Right"
                        Padding="14,10"
                        Background="#E51F1F1F"
                        Style="{StaticResource PanelBorderStyle}">
                        <Grid ColumnSpacing="12" RowDefinitions="Auto, Auto" ColumnDefinitions="Auto, Auto, Auto, Auto, Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Формула" FontWeight="SemiBold" Opacity="0.8" />
                            <TextBlock x:Name="FormulaText" Grid.Row="1" Grid.Column="0" Text="zₙ₊₁ = zₙ² + c" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Фрактал" FontWeight="SemiBold" Opacity="0.8" />
                            <TextBlock x:Name="FractalNameText" Grid.Row="1" Grid.Column="1" Text="Julia" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Метод окрашивания" FontWeight="SemiBold" Opacity="0.8" />
                            <TextBlock x:Name="ColoringMethodText" Grid.Row="1" Grid.Column="2" Text="Cosine palette" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Масштаб" FontWeight="SemiBold" Opacity="0.8" />
                            <TextBlock x:Name="ScaleText" Grid.Row="1" Grid.Column="3" Text="1.00" />

                            <Button Grid.Row="0"
                            Grid.Column="4"
                            HorizontalAlignment="Right"
                            Content="×"
                            Click="FractalInfoPanelCloseButton_Click"
                            Padding="6,0"
                            MinWidth="28"
                            Height="28"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="Закрыть информацию о фрактале" />
                        </Grid>
                    </Border>

                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <Border x:Name="LogicPanel"
                                Visibility="Collapsed"
                                Grid.Column="1"
                                Padding="16,16,10,16"
                                Background="#E51F1F1F"
                                Style="{StaticResource PanelBorderStyle}">
                            <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="МАТЕМАТИКА" FontWeight="SemiBold" Opacity="0.8" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="×" Click="ParametersPanelCloseButton_Click" Padding="6,0" MinWidth="28" Height="28" AutomationProperties.Name="Закрыть панель математики" />
                                </Grid>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="15" Spacing="8">
                                    <StackPanel x:Name="JuliaConstantPanel" Spacing="8">
                                        <TextBlock Text="Константа Julia" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="JuliaConstantValue"
                                                   HorizontalAlignment="Center"
                                                   Text="c = 0,00 + 0,00i" />
                                        <Border Background="#202020"
                                                Style="{StaticResource PadBorderStyle}"
                                                HorizontalAlignment="Center">
                                            <Canvas x:Name="XYPad"
                                                    Width="240"
                                                    Height="240"
                                                    Background="Gray"
                                                    PointerPressed="XYPad_PointerPressed"
                                                    PointerMoved="XYPad_PointerMoved"
                                                    PointerReleased="XYPad_PointerReleased"
                                                    PointerCanceled="XYPad_PointerCanceled"
                                                    PointerCaptureLost="XYPad_PointerCaptureLost">
                                                <Ellipse x:Name="Thumb"
                                                         Width="20"
                                                         Height="20"
                                                         Fill="White"
                                                         IsHitTestVisible="False" />
                                            </Canvas>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Степень" />
                                    <Grid ColumnDefinitions="*,64">
                                        <Slider Tag="Power" Minimum="2" Maximum="12" StepFrequency="1" Value="2" ValueChanged="ParameterSlider_ValueChanged" />
                                        <TextBox x:Name="PowerValue" Grid.Column="1" Text="2" Tag="Power" KeyDown="ParameterTextBox_KeyDown" LostFocus="ParameterTextBox_LostFocus" />
                                    </Grid>
                                    <TextBlock Text="Радиус выхода" />
                                    <Grid ColumnDefinitions="*,64">
                                        <Slider Tag="EscapeRadius" Minimum="2" Maximum="20000" StepFrequency="0.1" Value="100" ValueChanged="ParameterSlider_ValueChanged" />
                                        <TextBox x:Name="EscapeRadiusValue" Grid.Column="1" Text="100.00" Tag="EscapeRadius" KeyDown="ParameterTextBox_KeyDown" LostFocus="ParameterTextBox_LostFocus" />
                                    </Grid>
                                    <TextBlock Text="Максимум итераций" />
                                    <Grid ColumnDefinitions="*,64">
                                        <Slider Tag="MaxIterations" Minimum="0" Maximum="2000" StepFrequency="1" Value="100" ValueChanged="ParameterSlider_ValueChanged" />
                                        <TextBox x:Name="MaxIterationsValue" Grid.Column="1" Text="100" Tag="MaxIterations" KeyDown="ParameterTextBox_KeyDown" LostFocus="ParameterTextBox_LostFocus" />
                                    </Grid>
                                    <TextBlock Text="Фрактал" Margin="0,8,0,0" />
                                     <Border Height="140"
                                             Background="#202020"
                                             BorderBrush="#505050"
                                             BorderThickness="1"
                                              Style="{StaticResource SelectorBorderStyle}"
                                             Padding="1">
                                         <ListBox x:Name="FunctionSelector"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  SelectedIndex="1"
                                                  SelectionChanged="FunctionSelector_SelectionChanged">
                                             <ListBoxItem Content="Mandelbrot" />
                                             <ListBoxItem Content="Julia" />
                                             <ListBoxItem Content="Синус Mandelbrot" />
                                             <ListBoxItem Content="Синус Julia" />
                                             <ListBoxItem Content="Косинус Mandelbrot" />
                                             <ListBoxItem Content="Косинус Julia" />
                                         </ListBox>
                                     </Border>
                                    <TextBlock Text="Метод окрашивания" Margin="0,8,0,0" />
                                     <Border Height="140"
                                             Background="#202020"
                                             BorderBrush="#505050"
                                             BorderThickness="1"
                                              Style="{StaticResource SelectorBorderStyle}"
                                             Padding="1">
                                         <ListBox x:Name="ColoringMethodSelector"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  SelectedIndex="0"
                                                  SelectionChanged="ColoringMethodSelector_SelectionChanged">
                                             <ListBoxItem Content="Cosine palette" />
                                             <ListBoxItem Content="Monochrome" />
                                             <ListBoxItem Content="Orbit trap" />
                                             <ListBoxItem Content="Metallic surface" />
                                         </ListBox>
                                     </Border>
                                            <TextBlock Text="Тип Orbit Trap" Margin="0,8,0,0" />
                                             <Border Height="140"
                                                     Background="#202020"
                                                     BorderBrush="#505050"
                                                     BorderThickness="1"
                                                      Style="{StaticResource SelectorBorderStyle}"
                                                     Padding="1">
                                                 <ComboBox x:Name="OrbitTrapTypeSelector"
                                                           SelectionChanged="OrbitTrapTypeSelector_SelectionChanged">
                                                     <ComboBoxItem Content="Точка" />
                                                     <ComboBoxItem Content="Горизонтальная линия" />
                                                     <ComboBoxItem Content="Вертикальная линия" />
                                                     <ComboBoxItem Content="Крест" />
                                                     <ComboBoxItem Content="Круг" />
                                                     <ComboBoxItem Content="Квадрат" />
                                                     <ComboBoxItem Content="Ромб" />
                                                 </ComboBox>
                                             </Border>
                                            <TextBlock Text="Сглаживание Escape Time" Margin="0,8,0,0" />
                                    <RadioButtons x:Name="SmoothingMethodSelector"
                                                  SelectedIndex="1"
                                                  SelectionChanged="SmoothingMethodSelector_SelectionChanged">
                                        <RadioButton Content="Rough" />
                                        <RadioButton Content="Smooth" />
                                    </RadioButtons>
                                </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border x:Name="ColorPanel"
                                Visibility="Collapsed"
                                Grid.Column="1"
                                Padding="16,16,10,16"
                                Background="#E51F1F1F"
                                Style="{StaticResource PanelBorderStyle}">
                            <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Палитра HSV" FontWeight="SemiBold" Opacity="0.8" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="×" Click="ColorPanelCloseButton_Click" Padding="6,0" MinWidth="28" Height="28" AutomationProperties.Name="Закрыть панель цвета" />
                                </Grid>
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="PalettePanel" Margin="10" Spacing="8">
                                <TextBlock Text="Основной цвет" />
                                <Border Style="{StaticResource CircleBorderStyle}" HorizontalAlignment="Center">
                                    <Canvas x:Name="HsvWheel"
                                            Width="220"
                                            Height="220"
                                            Background="Transparent"
                                            PointerPressed="HsvWheel_PointerPressed"
                                            PointerMoved="HsvWheel_PointerMoved"
                                            PointerReleased="HsvWheel_PointerReleased"
                                            PointerCanceled="HsvWheel_PointerCanceled"
                                            PointerCaptureLost="HsvWheel_PointerCaptureLost">
                                        <Image x:Name="HsvWheelImage"
                                               Width="220"
                                               Height="220"
                                               IsHitTestVisible="False" />
                                        <Ellipse x:Name="HsvWheelThumb"
                                                 Width="18"
                                                 Height="18"
                                                 Stroke="White"
                                                 StrokeThickness="2"
                                                 IsHitTestVisible="False" />
                                    </Canvas>
                                </Border>
                                    <Grid ColumnDefinitions="*,64">
                                    <Slider x:Name="BrightnessSlider" Tag="Brightness" Minimum="0" Maximum="1" StepFrequency="0.01" Value="0.5" ValueChanged="ParameterSlider_ValueChanged" />
                                     <TextBox x:Name="BrightnessValue" Grid.Column="1" Text="0.50" Tag="Brightness" KeyDown="ParameterTextBox_KeyDown" LostFocus="ParameterTextBox_LostFocus" />
                                </Grid>
                                <Border x:Name="SelectedColorPreview" Height="24" Background="#FF7F260D" Style="{StaticResource PreviewBorderStyle}" />
                                <TextBlock Text="Base R / G / B" Margin="0,8,0,0" />
                                             <Grid ColumnDefinitions="*,64"><Slider x:Name="BaseRSlider" Tag="BaseR" Minimum="0" Maximum="255" StepFrequency="1" Value="128" ValueChanged="ParameterSlider_ValueChanged" /><TextBox x:Name="BaseRValue" Grid.Column="1" Text="128" Tag="BaseR" KeyDown="ParameterTextBox_KeyDown" LostFocus="ParameterTextBox_LostFocus" /></Grid>
                                             <Grid ColumnDefinitions="*,64"><Slider x:Name="BaseGSlider" Tag="BaseG" Minimum="0" Maximum="255" StepFrequency="1" Value="38" ValueChanged="ParameterSlider_ValueChanged" /><TextBox x:Name="BaseGValue" Grid.Column="1" Text="38" Tag="BaseG" KeyDown="ParameterTextBox_KeyDown" LostFocus="ParameterTextBox_LostFocus" /></Grid>
                                             <Grid ColumnDefinitions="*,64"><Slider x:Name="BaseBSlider" Tag="BaseB" Minimum="0" Maximum="255" StepFrequency="1" Value="13" ValueChanged="ParameterSlider_ValueChanged" /><TextBox x:Name="BaseBValue" Grid.Column="1" Text="13" Tag="BaseB" KeyDown="ParameterTextBox_KeyDown" LostFocus="ParameterTextBox_LostFocus" /></Grid>
                                    <TextBlock Text="Amplitude R / G / B" Margin="0,8,0,0" />
                                             <Grid ColumnDefinitions="*,64"><Slider Tag="AmplitudeR" Minimum="0" Maximum="1" StepFrequency="0.01" Value="0.5" ValueChanged="ParameterSlider_ValueChanged" /><TextBox x:Name="AmplitudeRValue" Grid.Column="1" Text="0.50" Tag="AmplitudeR" KeyDown="ParameterTextBox_KeyDown" LostFocus="ParameterTextBox_LostFocus" /></Grid>
                                             <Grid ColumnDefinitions="*,64"><Slider Tag="AmplitudeG" Minimum="0" Maximum="1" StepFrequency="0.01" Value="0.35" ValueChanged="ParameterSlider_ValueChanged" /><TextBox x:Name="AmplitudeGValue" Grid.Column="1" Text="0.35" Tag="AmplitudeG" KeyDown="ParameterTextBox_KeyDown" LostFocus="ParameterTextBox_LostFocus" /></Grid>
                                             <Grid ColumnDefinitions="*,64"><Slider Tag="AmplitudeB" Minimum="0" Maximum="1" StepFrequency="0.01" Value="0.25" ValueChanged="ParameterSlider_ValueChanged" /><TextBox x:Name="AmplitudeBValue" Grid.Column="1" Text="0.25" Tag="AmplitudeB" KeyDown="ParameterTextBox_KeyDown" LostFocus="ParameterTextBox_LostFocus" /></Grid>
                                <TextBlock Text="Frequency R / G / B" Margin="0,8,0,0" />
                                            <Grid ColumnDefinitions="*,64"><Slider Tag="FrequencyR" Minimum="0" Maximum="2" StepFrequency="0.01" Value="1" ValueChanged="ParameterSlider_ValueChanged" /><TextBox x:Name="FrequencyRValue" Grid.Column="1" Text="1.00" Tag="FrequencyR" KeyDown="ParameterTextBox_KeyDown" LostFocus="ParameterTextBox_LostFocus" /></Grid>
                                            <Grid ColumnDefinitions="*,64"><Slider Tag="FrequencyG" Minimum="0" Maximum="2" StepFrequency="0.01" Value="0.8" ValueChanged="ParameterSlider_ValueChanged" /><TextBox x:Name="FrequencyGValue" Grid.Column="1" Text="0.80" Tag="FrequencyG" KeyDown="ParameterTextBox_KeyDown" LostFocus="ParameterTextBox_LostFocus" /></Grid>
                                            <Grid ColumnDefinitions="*,64"><Slider Tag="FrequencyB" Minimum="0" Maximum="2" StepFrequency="0.01" Value="0.5" ValueChanged="ParameterSlider_ValueChanged" /><TextBox x:Name="FrequencyBValue" Grid.Column="1" Text="0.50" Tag="FrequencyB" KeyDown="ParameterTextBox_KeyDown" LostFocus="ParameterTextBox_LostFocus" /></Grid>
                                <TextBlock Text="Phase R / G / B" Margin="0,8,0,0" />
                                            <Grid ColumnDefinitions="*,64"><Slider Tag="PhaseR" Minimum="0" Maximum="1" StepFrequency="0.01" Value="0" ValueChanged="ParameterSlider_ValueChanged" /><TextBox x:Name="PhaseRValue" Grid.Column="1" Text="0.00" Tag="PhaseR" KeyDown="ParameterTextBox_KeyDown" LostFocus="ParameterTextBox_LostFocus" /></Grid>
                                            <Grid ColumnDefinitions="*,64"><Slider Tag="PhaseG" Minimum="0" Maximum="1" StepFrequency="0.01" Value="0.05" ValueChanged="ParameterSlider_ValueChanged" /><TextBox x:Name="PhaseGValue" Grid.Column="1" Text="0.05" Tag="PhaseG" KeyDown="ParameterTextBox_KeyDown" LostFocus="ParameterTextBox_LostFocus" /></Grid>
                                            <Grid ColumnDefinitions="*,64"><Slider Tag="PhaseB" Minimum="0" Maximum="1" StepFrequency="0.01" Value="0.1" ValueChanged="ParameterSlider_ValueChanged" /><TextBox x:Name="PhaseBValue" Grid.Column="1" Text="0.10" Tag="PhaseB" KeyDown="ParameterTextBox_KeyDown" LostFocus="ParameterTextBox_LostFocus" /></Grid>
                            </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                </Grid>

                </Grid>
            </Grid>
        </Grid>
    </Grid>
    

</Window>
